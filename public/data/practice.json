      "source": { "title": "Active Calculus · The notion of limit", "author": "Matthew Boelkins et al.", "url": "https://activecalculus.org/single-alt/sec-1-2-lim.html", "attribution": "Exercise 3 from Active Calculus Single Variable", "license": { "code": "CC-BY-SA-4.0", "name": "CC BY-SA 4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/", "usage": "embedded" }, "modified": true, "modificationNote": "Reformatted for a single-question study card; mathematical content unchanged." }
    },
