      ["End behavior","f(x)\\sim a_nx^n\\quad (|x|\\to\\infty)"],
      ["Vertical asymptote","q(c)=0\\text{ after common factors are removed}"],
      ["Hole","\\frac{(x-c)p(x)}{(x-c)q(x)}=\\frac{p(x)}{q(x)},\\quad x\\ne c"]
    ]},
    {"title":"Exponents + logarithms","items":[
      ["Exponent rules","a^ma^n=a^{m+n},\\quad (a^m)^n=a^{mn},\\quad a^{-n}=\\frac1{a^n}"],
      ["Exponential model","f(x)=ab^x"],
      ["Log definition","\\log_b x=y\\iff b^y=x"],
      ["Log properties","\\log_b(MN)=\\log_bM+\\log_bN,\\quad \\log_b(M^p)=p\\log_bM"],
      ["Change of base","\\log_bx=\\frac{\\ln x}{\\ln b}"]
    ]},
    {"title":"Sequences + finance","items":[
      ["Arithmetic sequence","a_n=a_1+(n-1)d"],
      ["Geometric sequence","a_n=a_1r^{n-1}"],
      ["Arithmetic sum","S_n=\\frac n2(a_1+a_n)"],
      ["Geometric sum","S_n=a_1\\frac{1-r^n}{1-r}"],
      ["Compound interest","A=P\\left(1+\\frac rn\\right)^{nt}"]
    ]},
    {"title":"Trigonometry","items":[
      ["Radians + arc length","\\theta=\\frac{s}{r},\\quad s=r\\theta"],
      ["Pythagorean identities","\\sin^2\\theta+\\cos^2\\theta=1,\\quad 1+\\tan^2\\theta=\\sec^2\\theta"],
      ["Angle addition","\\sin(\\alpha+\\beta)=\\sin\\alpha\\cos\\beta+\\cos\\alpha\\sin\\beta"],
      ["Double angle","\\sin(2\\theta)=2\\sin\\theta\\cos\\theta,\\quad \\cos(2\\theta)=\\cos^2\\theta-\\sin^2\\theta"],
      ["Sinusoidal model","y=A\\sin(B(x-C))+D,\\quad \\text{period}=\\frac{2\\pi}{|B|}"]
    ]},
    {"title":"Triangles + polar coordinates","items":[
