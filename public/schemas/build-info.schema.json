{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-dive-ap.local/schemas/build-info.schema.json",
  "title": "Full Dive AP build information",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "buildId", "builtAt"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "buildId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
    "builtAt": { "type": "string", "format": "date-time" }
  }
}
