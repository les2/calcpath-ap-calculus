{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-dive-ap.local/schemas/course.schema.json",
  "title": "Full Dive AP course manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "title", "shortTitle", "description", "accent", "disclaimer", "quality", "datasets", "navigation", "pages"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "shortTitle": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedUnitCount", "expectedTopicCount", "minimumEmbeddedQuestionsPerTopic"],
      "properties": {
        "expectedUnitCount": { "type": "integer", "minimum": 1 },
        "expectedTopicCount": { "type": "integer", "minimum": 1 },
        "minimumEmbeddedQuestionsPerTopic": { "type": "integer", "minimum": 0 }
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap", "tools", "reference", "practice"],
      "properties": {
        "roadmap": { "$ref": "#/$defs/file" },
        "tools": { "$ref": "#/$defs/file" },
        "reference": { "$ref": "#/$defs/file" },
        "practice": { "$ref": "#/$defs/file" }
      }
    },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap", "tools", "reference", "practice"],
      "properties": {
        "roadmap": { "$ref": "#/$defs/roadmapPage" },
        "tools": { "$ref": "#/$defs/basicPage" },
        "reference": { "$ref": "#/$defs/referencePage" },
        "practice": { "$ref": "#/$defs/practicePage" }
      }
    }
  },
  "$defs": {
    "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*\\.json$" },
    "basicPage": {
      "type": "object",
      "required": ["eyebrow", "heading", "emphasis", "description"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "emphasis": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "roadmapPage": {
      "type": "object", "additionalProperties": false,
      "required": ["heroEyebrow", "heading", "emphasis", "description", "sectionEyebrow", "sectionHeading", "sectionDescription", "searchPlaceholder", "visuals", "filters"],
      "properties": {
        "heroEyebrow": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "emphasis": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sectionEyebrow": { "type": "string", "minLength": 1 },
        "sectionHeading": { "type": "string", "minLength": 1 },
        "sectionDescription": { "type": "string", "minLength": 1 },
        "searchPlaceholder": { "type": "string", "minLength": 1 },
        "visuals": {
          "type": "object", "additionalProperties": false,
          "required": ["graphLabel", "formula", "result", "miniFormula"],
          "properties": {
            "graphLabel": { "type": "string", "minLength": 1 },
            "formula": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "miniFormula": { "type": "string", "minLength": 1 }
          }
        },
        "filters": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "unitCourses"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "unitCourses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "referencePage": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/basicPage" },
        {
          "type": "object",
          "required": ["printLabel", "noteTitle", "noteText"],
          "properties": {
            "printLabel": { "type": "string", "minLength": 1 },
            "noteTitle": { "type": "string", "minLength": 1 },
            "noteText": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "practicePage": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/basicPage" },
        {
          "type": "object",
          "required": ["modeLabel", "sessionLabel", "sessionPlural", "loadoutLabel", "filterTags", "unitAccents", "sourceLabels"],
          "properties": {
            "modeLabel": { "type": "string", "minLength": 1 },
            "sessionLabel": { "type": "string", "minLength": 1 },
            "sessionPlural": { "type": "string", "minLength": 1 },
            "loadoutLabel": { "type": "string", "minLength": 1 },
            "filterTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "unitAccents": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
            "sourceLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
