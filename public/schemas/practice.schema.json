{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-dive-ap.local/schemas/practice.schema.json",
  "title": "Full Dive AP practice catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "revision", "generatedAt", "licenseNotice", "catalogStats", "sources", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 5 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "licenseNotice": { "type": "string" },
    "catalogStats": { "type": "object" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "url", "usage"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "usage": { "enum": ["embedded", "link-only"] }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "author", "url", "attribution", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "attribution": { "type": "string", "minLength": 1 },
        "license": { "$ref": "#/$defs/license" }
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["exerciseId", "promptUrl", "answerUrl", "transcription", "verifiedAt"],
      "properties": {
        "exerciseId": { "type": "string", "minLength": 1 },
        "promptUrl": { "$ref": "#/$defs/httpsUrl" },
        "answerUrl": { "$ref": "#/$defs/httpsUrl" },
        "transcription": { "enum": ["format-only", "link-only"] },
        "verifiedAt": { "type": "string", "format": "date" }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceQuestionId", "collection", "course", "format", "difficulty", "estimatedMinutes", "calculator", "answerKind", "tags"],
      "properties": {
        "sourceQuestionId": { "type": "string", "minLength": 1 },
        "collection": { "type": "string", "minLength": 1 },
        "course": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard", "ridiculous"] },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "calculator": { "type": "string", "minLength": 1 },
        "answerKind": { "type": "string", "minLength": 1 },
        "publishedYear": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "questionBase": {
      "type": "object",
      "required": ["id", "type", "topicId", "topic", "unit", "title", "videoUrl", "referenceUrl", "metadata", "sourceId", "locator"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["embedded", "external"] },
        "topicId": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)+$" },
        "topic": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "videoUrl": { "$ref": "#/$defs/httpsUrl" },
        "referenceUrl": { "$ref": "#/$defs/httpsUrl" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "sourceId": { "type": "string", "minLength": 1 },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },
    "question": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/questionBase" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["promptHtml", "answerHtml"],
              "properties": {
                "id": true, "type": { "const": "embedded" }, "topicId": true, "topic": true, "unit": true, "title": true,
                "videoUrl": true, "referenceUrl": true, "metadata": true, "sourceId": true, "locator": true,
                "promptText": { "type": "string" }, "promptTex": { "type": "string" }, "promptHtml": { "type": "string", "minLength": 1 },
                "answerText": { "type": "string" }, "answerTex": { "type": "string" }, "answerHtml": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/questionBase" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["problemUrl", "solutionUrl"],
              "properties": {
                "id": true, "type": { "const": "external" }, "topicId": true, "topic": true, "unit": true, "title": true,
                "videoUrl": true, "referenceUrl": true, "metadata": true, "sourceId": true, "locator": true,
                "problemUrl": { "$ref": "#/$defs/httpsUrl" }, "solutionUrl": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          ]
        }
      ]
    }
  }
}
